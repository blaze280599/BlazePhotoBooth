<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (README §15.3): seeds pastel sample strips for testing the album on the phone, and lets
     reduce motion be forced on or off without changing the phone's settings (§6.7). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name=".debug.SampleSeedProvider"
            android:authorities="${applicationId}.sampleseed"
            android:exported="false" />
        <provider
            android:name=".debug.ReduceMotionTrigger"
            android:authorities="${applicationId}.reducemotion"
            android:exported="false" />
    </application>
</manifest>
